# UIKEY LABS Environment Variables Template (.env.example)
# Copy this file to .env on your backend server. Never commit .env to Git!

PORT=8080
SQLITE_DB_PATH=uikeylabs_merchants.db

# Optional Supabase Backend Configuration (Server-Side Only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
